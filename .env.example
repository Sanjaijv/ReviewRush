ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://reviewrush:reviewrush@localhost:5432/reviewrush
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

DIFF_MAX_FILES=300
DIFF_MAX_FILE_PATCH_BYTES=200000
DIFF_MAX_TOTAL_CHANGED_LINES=6000
DIFF_MAX_TOTAL_PROMPT_BYTES=400000

# Deterministic analysis pipeline (Phase 5). Keep disabled unless the worker
# has been given controlled Docker access (see README) - running this sandbox
# requires the worker to be able to launch containers for untrusted PR code.
ANALYSIS_SANDBOX_ENABLED=false
ANALYSIS_DOCKER_BINARY=docker
ANALYSIS_DEFAULT_IMAGE=python:3.12-slim
ANALYSIS_WORKDIR=/var/lib/reviewrush/analysis
ANALYSIS_VOLUME_NAME=reviewrush_analysis_workspace
ANALYSIS_TIMEOUT_SECONDS=600
ANALYSIS_MEMORY_LIMIT_MB=512
ANALYSIS_CPU_LIMIT=1.0
ANALYSIS_PIDS_LIMIT=128
ANALYSIS_MAX_LOG_BYTES=64000
ANALYSIS_MAX_REPO_BYTES=200000000

ANALYSIS_SEMGREP_ENABLED=true
ANALYSIS_SEMGREP_REQUIRED=true
ANALYSIS_SEMGREP_IMAGE=semgrep/semgrep:latest
ANALYSIS_SEMGREP_NETWORK_ENABLED=false

ANALYSIS_GITLEAKS_ENABLED=true
ANALYSIS_GITLEAKS_REQUIRED=true
ANALYSIS_GITLEAKS_IMAGE=zricethezav/gitleaks:latest

ANALYSIS_DEPENDENCY_SCAN_ENABLED=true
ANALYSIS_DEPENDENCY_SCAN_REQUIRED=false
ANALYSIS_DEPENDENCY_SCAN_NETWORK_ENABLED=false
ANALYSIS_DEPENDENCY_SCAN_PYTHON_IMAGE=python:3.12-slim
ANALYSIS_DEPENDENCY_SCAN_NODE_IMAGE=node:20-slim

# AI reviewer (Phase 6). Keep disabled until a model is reachable - either a
# local Ollama server with the configured model pulled
# (`ollama pull qwen2.5-coder:7b`), or a hosted provider (Groq) via an API
# key. See the "AI reviewer" section of README.md.
AI_REVIEW_ENABLED=false
AI_PROVIDER=ollama
# http://localhost:11434 only works if the worker runs directly on the host.
# Via `docker compose up`, use http://host.docker.internal:11434 instead.
AI_OLLAMA_BASE_URL=http://localhost:11434
# Only used when AI_PROVIDER=groq - a free API key from console.groq.com/keys.
AI_GROQ_API_KEY=
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen2.5-coder:7b
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_PROMPT_BYTES=400000
AI_MAX_ISSUES=50

# AI auto-fix. Off by default, and requires two layers of consent: this
# global switch AND `.reviewrush.yml: auto_fix.enabled: true` in the target
# repository. Never touches security findings regardless of configuration.
AUTOFIX_ENABLED=false
AUTOFIX_MAX_FIXES_PER_SNAPSHOT=3
AUTOFIX_MAX_OUTPUT_TOKENS=2048

# Safe auto-approval and auto-merge (Phase 9). Keep disabled - flipping it
# on is an organization-level decision, and it only takes effect on repos
# that also opt in with `merge.enabled: true` in their .reviewrush.yml.
MERGE_AUTO_MERGE_ENABLED=false

# Repository-aware context (Phase 10). Keep disabled unless the worker should
# download a full repo tree checkout (same mechanism as the analysis sandbox,
# no Docker required) to retrieve related code/tests/config for the AI
# reviewer.
CONTEXT_ENABLED=false

# RAG and scalable code indexing (Phase 11). Requires CONTEXT_ENABLED=true.
# Symbol-chunk storage and lexical/graph re-ranking always run once context
# is enabled; semantic (embedding) retrieval is a further opt-in that also
# needs an embeddings-capable model pulled in Ollama (e.g. `ollama pull
# nomic-embed-text`) and a pgvector-enabled Postgres (see docker-compose.yml).
CONTEXT_EMBEDDINGS_ENABLED=false
CONTEXT_EMBEDDINGS_MODEL=nomic-embed-text

# Dashboard, configuration, and auditability (Phase 12). Keep disabled until
# a GitHub OAuth client (Settings > Developer settings > OAuth Apps, or the
# "User authorization" section of the GitHub App itself) is configured with
# an authorization callback of "<DASHBOARD_BASE_URL>/api/v1/dashboard/auth/callback".
# DASHBOARD_SESSION_SECRET must be a long random value in production -
# generate one with `openssl rand -hex 32`. Never reuse GITHUB_WEBHOOK_SECRET.
DASHBOARD_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_SECONDS=3600
DASHBOARD_BASE_URL=http://localhost:8000
DASHBOARD_DEFAULT_RETENTION_DAYS=90

# Reliability, observability, and production hardening (Phase 13).
RELIABILITY_TASK_MAX_RETRIES=5
RELIABILITY_TASK_RETRY_BACKOFF_MAX_SECONDS=300
RELIABILITY_LOCK_ENABLED=true
RELIABILITY_LOCK_TIMEOUT_SECONDS=60
RELIABILITY_LOCK_WAIT_SECONDS=10.0

METRICS_ENABLED=true

# Distributed tracing. Keep disabled unless an OTLP collector (e.g. an
# OpenTelemetry Collector, Jaeger, Tempo) is reachable at the configured
# endpoint.
TRACING_ENABLED=false
TRACING_SERVICE_NAME=reviewrush
TRACING_OTLP_ENDPOINT=http://localhost:4318
TRACING_SAMPLE_RATIO=1.0

# Cost and quota limits. Keep disabled unless an operator wants to cap AI
# review spend per installation/repository - exceeding a quota degrades to
# human review, it never blocks the deterministic pipeline or auto-approves.
QUOTA_ENABLED=false
QUOTA_MAX_AI_REVIEWS_PER_REPOSITORY_PER_DAY=200
QUOTA_MAX_AI_REVIEWS_PER_INSTALLATION_PER_DAY=1000

# Feedback collection and model evaluation. The eval admin API (dataset
# build, benchmark run, promotion) is a cross-tenant governance surface with
# no per-organization RBAC yet, so it stays disabled and rejects everything
# unless both a token is set and the flag is on.
EVAL_ENABLED=false
EVAL_ADMIN_TOKEN=
EVAL_PROMOTION_MIN_PRECISION=0.6
EVAL_PROMOTION_MIN_RECALL=0.6
FEEDBACK_DEFAULT_RETENTION_DAYS=365

# Custom-model fine-tuning (Phase 16). Off by default and gated the same way
# as the eval admin API above. Only appropriate once thousands of consented,
# human-validated examples exist - see docs/fine-tuning.md. This does not
# bundle a trainer: FINETUNE_TRAINER_COMMAND must point at an
# operator-provisioned LoRA/QLoRA training script.
FINETUNE_ENABLED=false
FINETUNE_ADMIN_TOKEN=
FINETUNE_BASE_MODEL=qwen2.5-coder:7b
FINETUNE_METHOD=lora
FINETUNE_TRAINER_COMMAND=
FINETUNE_TRAINER_TIMEOUT_SECONDS=3600
FINETUNE_OUTPUT_DIR=/var/lib/reviewrush/finetune
FINETUNE_MIN_TRAINING_EXAMPLES=1000
FINETUNE_OLLAMA_CREATE_ENABLED=false
FINETUNE_OLLAMA_BINARY=ollama
FINETUNE_MAX_RECALL_REGRESSION=0.05
FINETUNE_MAX_FALSE_POSITIVE_RATE_INCREASE=0.5
FINETUNE_SHADOW_EVAL_ENABLED=false
FINETUNE_SHADOW_CANDIDATE_PROVIDER=ollama
FINETUNE_SHADOW_CANDIDATE_MODEL=

# Multi-tenant SaaS readiness (Phase 17). One Organization is auto-created
# per GitHub App Installation. Rate limiting is off by default; when
# enabled, the webhook endpoint is limited per installation id and the
# dashboard API per authenticated GitHub user, both failing open if Redis
# itself is unreachable and failing closed (429) once the limit is hit.
TENANCY_RATE_LIMIT_ENABLED=false
TENANCY_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
TENANCY_DASHBOARD_RATE_LIMIT_PER_MINUTE=120
