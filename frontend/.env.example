# The FastAPI backend this frontend proxies /api/* to (see next.config.ts).
# In production this is typically internal to the deployment network, with a
# reverse proxy in front of both services on one public origin instead.
BACKEND_ORIGIN=http://localhost:8010

# Optional server-only bearer token for /api/v1/eval and /api/v1/finetune.
# Never expose this as NEXT_PUBLIC_REVIEWRUSH_ADMIN_TOKEN.
REVIEWRUSH_ADMIN_TOKEN=
